import express from "express";
import { promises as fs } from "node:fs";
import path from "node:path";
import os from "node:os";
import { execFile } from "node:child_process";
import { promisify } from "node:util";

import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { StreamableHTTPServerTransport } from "@modelcontextprotocol/sdk/server/streamableHttp.js";
import * as z from "zod/v4";

const execFileAsync = promisify(execFile);
const BASE = path.join(os.homedir(), "termux-mcp", "workspace");
const TOKEN_PATH = path.join(
  os.homedir(), ".config", "termux-mcp", "token"
);
const TOKEN = (await fs.readFile(TOKEN_PATH, "utf8")).trim();
const PORT = 8000;

await fs.mkdir(BASE, { recursive: true });

function safeFile(name) {
  if (
    typeof name !== "string" ||
    !name ||
    name === "." ||
    name === ".." ||
    name.includes("/") ||
    name.includes("\\")
  ) {
    throw new Error("Gunakan nama file langsung di workspace.");
  }
  return path.join(BASE, name);
}

function makeServer() {
  const server = new McpServer({
    name: "termux-remote",
    version: "1.0.0"
  });

  server.registerTool(
    "list_files",
    {
      description: "Daftar file workspace Termux.",
      inputSchema: {}
    },
    async () => {
      const items = await fs.readdir(BASE, { withFileTypes: true });
      return {
        content: [{
          type: "text",
          text: items.map(x =>
            `${x.isDirectory() ? "[DIR]" : "[FILE]"} ${x.name}`
          ).join("\n") || "(workspace kosong)"
        }]
      };
    }
  );

  server.registerTool(
    "read_file",
    {
      description: "Membaca file teks di workspace.",
      inputSchema: { name: z.string() }
    },
    async ({ name }) => {
      const p = safeFile(name);
      const info = await fs.stat(p);
      if (!info.isFile()) throw new Error("Bukan file biasa.");
      if (info.size > 200000) throw new Error("File terlalu besar.");
      return {
        content: [{
          type: "text",
          text: await fs.readFile(p, "utf8")
        }]
      };
    }
  );

  server.registerTool(
    "write_file",
    {
      description: "Membuat atau mengganti file teks di workspace.",
      inputSchema: {
        name: z.string(),
        content: z.string()
      }
    },
    async ({ name, content }) => {
      if (content.length > 200000) {
        throw new Error("Konten terlalu besar.");
      }
      const p = safeFile(name);
      await fs.writeFile(p, content, "utf8");
      return {
        content: [{
          type: "text",
          text: `Berhasil menyimpan ${name}`
        }]
      };
    }
  );

  server.registerTool(
    "run_script",
    {
      description:
        "Menjalankan file .py atau .js di workspace. " +
        "Jalankan hanya skrip yang sudah diperiksa.",
      inputSchema: { name: z.string() }
    },
    async ({ name }) => {
      const p = safeFile(name);
      const ext = path.extname(p).toLowerCase();

      if (![".py", ".js"].includes(ext)) {
        throw new Error("Hanya file .py dan .js.");
      }

      const info = await fs.stat(p);
      if (!info.isFile()) throw new Error("Bukan file biasa.");

      const executable = ext === ".py" ? "python" : process.execPath;

      try {
        const result = await execFileAsync(
          executable,
          [p],
          {
            cwd: BASE,
            timeout: 30000,
            maxBuffer: 1024 * 1024
          }
        );

        return {
          content: [{
            type: "text",
            text: (result.stdout + "\n" + result.stderr).slice(0, 12000)
              || "(skrip selesai tanpa output)"
          }]
        };
      } catch (e) {
        return {
          content: [{
            type: "text",
            text: `Proses gagal atau timeout.\n${
              (e.stdout || "") + "\n" + (e.stderr || e.message || "")
            }`.slice(0, 12000)
          }]
        };
      }
    }
  );

  return server;
}

const app = express();
app.disable("x-powered-by");

app.use("/mcp", (req, res, next) => {
  if (req.get("authorization") !== `Bearer ${TOKEN}`) {
    return res.status(401).json({ error: "Unauthorized" });
  }
  next();
});

app.use(express.json({ limit: "1mb" }));

app.post("/mcp", async (req, res) => {
  const server = makeServer();
  const transport = new StreamableHTTPServerTransport({
    sessionIdGenerator: undefined
  });

  try {
    await server.connect(transport);
    res.on("close", () => {
      void transport.close();
      void server.close();
    });
    await transport.handleRequest(req, res, req.body);
  } catch (e) {
    console.error("MCP error:", e);
    if (!res.headersSent) {
      res.status(500).json({ error: "Internal MCP error" });
    }
    void transport.close();
    void server.close();
  }
});

app.all("/mcp", (req, res) => {
  res.status(405).send("Method not allowed");
});

app.listen(PORT, "127.0.0.1", () => {
  console.log(`Termux MCP aktif di http://127.0.0.1:${PORT}/mcp`);
  console.log("Akses lokal saja; autentikasi token wajib.");
});
